# .env.example

# ── NVIDIA LLM (Language Model – Brain) ──────────────────────────────────────
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here
NVIDIA_LLM_MODEL=meta/llama-3.1-8b-instruct

# ── ElevenLabs TTS (Optional – better voice quality) ─────────────────────────
ELEVENLABS_API_KEY=sk_your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_monolingual_v1

# ── JARVIS Core Settings ──────────────────────────────────────────────────────
WAKE_WORD=jarvis
VOICE_ENABLED=true
MEMORY_FILE=jarvis_memory.json
MAX_HISTORY=10

# ── MCP Tool Server ───────────────────────────────────────────────────────────
# Set to true to expose tools over HTTP/SSE on the port below.
MCP_SERVER_ENABLED=false
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8765

# When true, tools marked as destructive require explicit user confirmation.
APPROVAL_MODE=false

# Maximum number of tool-calling rounds per user request.
MAX_TOOL_ITERATIONS=5

# Maximum seconds a single tool call may run.
TOOL_TIMEOUT=30

# ── Web API Keys (free tiers) ─────────────────────────────────────────────────
# OpenWeatherMap free tier – https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# ── Knowledge Base ────────────────────────────────────────────────────────────
KNOWLEDGE_STORE_FILE=jarvis_knowledge.json

# ── Home Automation (optional) ────────────────────────────────────────────────
# Base URL of your smart-home hub, e.g. http://homeassistant.local:8123
HOME_AUTOMATION_URL=

# ── Experimental UI Bridge (Whisperflowactions merge scaffolding) ─────────────
# Emits pipeline state events for a future HUD/Web UI connector.
UI_BRIDGE_ENABLED=false
UI_BRIDGE_MAX_EVENTS=200

# ── JARVIS v3 Vision API ───────────────────────────────────────────────────────
VISION_ENABLED=false
VISION_MODEL=llama-3.2-90b-vision-instruct
NVIDIA_VISION_API_KEY=your_nvidia_vision_key_here
VISION_CACHE_TTL=45

# ── JARVIS v3 Browser Automation ───────────────────────────────────────────────
BROWSER_AUTOMATION_ENABLED=false
USE_PLAYWRIGHT=true
BROWSER_HEADLESS=false
BROWSER_TIMEOUT=30

# ── JARVIS v3 Push-to-Talk ─────────────────────────────────────────────────────
PTT_ENABLED=false
PTT_HOTKEY=ctrl+space

# ── JARVIS v3 Overlay/HUD ──────────────────────────────────────────────────────
ENABLE_OVERLAY_UI=false
OVERLAY_POSITION=top-right
OVERLAY_OPACITY=0.9

# ── JARVIS v3 Persona System ───────────────────────────────────────────────────
PERSONA_SYSTEM_ENABLED=false
PERSONA_DATA_DIR=data/personas

# ── JARVIS v3 Multi-Provider Routing ───────────────────────────────────────────
LLM_PROVIDER=nvidia
FALLBACK_PROVIDERS=ollama

# ── JARVIS v3 Self-Healing ─────────────────────────────────────────────────────
SELF_HEALING_ENABLED=false
MAX_RECOVERY_ATTEMPTS=3
